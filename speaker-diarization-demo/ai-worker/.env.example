HOST=127.0.0.1
PORT=8000
# ASR must stay on CPU for this demo (Faster-Whisper / CTranslate2, not PyTorch).
DEVICE=cpu
COMPUTE_TYPE=int8
MODEL_SIZE=small.en
LANGUAGE=en
BEAM_SIZE=5
# CTranslate2 intra-op threads on CPU (0 = library default).
WHISPER_CPU_THREADS=0
# Optional: pin Hugging Face Whisper downloads under ai-worker/ (relative paths OK).
WHISPER_MODEL_CACHE_DIR=pretrained_models/faster_whisper
SAMPLE_RATE=16000
CHANNELS=1
VAD_ENERGY_THRESHOLD=0.0015
VAD_THRESHOLD=0.4
VAD_MIN_SILENCE_MS=200
VAD_SPEECH_PAD_MS=120

# ── Speaker diarization ───────────────────────────────────────────────────
# Cosine similarity: above this counts as the same speaker without extra checks.
# Raise to reduce merging two different people into one label; lower if one person
# is split across speaker_002 / speaker_003.
SPEAKER_SIMILARITY_THRESHOLD=0.42
# Scores below this never match anyone. Weak matches use SPEAKER_MATCH_MARGIN vs
# the second-best registered speaker (see diarization.py).
SPEAKER_CONTINUITY_FLOOR=0.18
# In the weak band (floor..threshold), best must beat second-best by at least this.
# Smaller value reduces false "new speaker" when two embeddings are close.
SPEAKER_MATCH_MARGIN=0.06

# When only Speaker 1 exists: false = merge weak scores in [LONE_SPEAKER_WEAK_MERGE_MIN, threshold);
# true = legacy: merge if score >= 75% of SPEAKER_SIMILARITY_THRESHOLD.
WEAK_MATCH_LONE_SPEAKER_RELAXATION=false

# Lone speaker only: min cosine similarity to merge into Speaker 1 (weak band). Below this,
# a long segment can create speaker_002. Lower if one person splits; raise if two people merge.
LONE_SPEAKER_WEAK_MERGE_MIN=0.30

# true = skip ECAPA and label everything Speaker 1 (SOLE_SPEAKER_ID). Default false.
SINGLE_SPEAKER_MODE=false
# SOLE_SPEAKER_ID=speaker_001
# SOLE_SPEAKER_DISPLAY=Speaker 1

# true = log cosine vs every enrolled speaker per segment (terminal).
LOG_DIAR_SCORES=false

# When embedding fails (very short clip), inherit last speaker (avoids Unknown on solo mic).
ALLOW_LAST_SPEAKER_FALLBACK=true

# Segments shorter than this may match others but will not create a new speaker_id.
MIN_NEW_SPEAKER_SEG_S=1.2

# Segment audio shorter than this is skipped for embedding extraction.
MIN_EMBED_SPEECH_S=0.3
MIN_WINDOW_RMS=0.015
SEGMENT_PAD_S=0.15

# How far each ASR window advances; the remainder is overlap for context.
WINDOW_S=4.0
STEP_S=3.0

# Clip segment times so nothing starts before the previous emitted end (fixes
# Whisper overlap like Speaker 2 ending after Speaker 1's next line starts).
RESOLVE_TIMELINE_OVERLAP=true
MIN_EMIT_DURATION_S=0.05

# EMA weight for updating a speaker embedding (lower = more stable identity).
EMBEDDING_SMOOTHING_ALPHA=0.08

# ── Speaker embedding ONNX (ECAPA) ──────────────────────────────────────────
# Default: download kenrunio/transcriber-speaker-onnx (ecapa-any-length.onnx) via HF Hub.
# ECAPA_ONNX_REPO_ID=kenrunio/transcriber-speaker-onnx
# ECAPA_ONNX_FILENAME=ecapa-any-length.onnx
# ECAPA_ONNX_CACHE_DIR=pretrained_models/ecapa_onnx
# Use a local file instead of Hub download:
# ECAPA_ONNX_PATH=C:\path\to\ecapa-any-length.onnx
# Optional: max input length in samples for fixed-shape graphs (0 = full clip).
# ECAPA_ONNX_MAX_SAMPLES=0
