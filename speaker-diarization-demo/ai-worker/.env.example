HOST=127.0.0.1
PORT=8000
# ASR must stay on CPU for this demo (Faster-Whisper / CTranslate2, not PyTorch).
DEVICE=cpu
COMPUTE_TYPE=int8
MODEL_SIZE=small.en
LANGUAGE=en
# Lower beam = faster ASR (5 = more accurate)
BEAM_SIZE=1
# CTranslate2 intra-op threads on CPU (0 = library default).
WHISPER_CPU_THREADS=0
# Optional: pin Hugging Face Whisper downloads under ai-worker/ (relative paths OK).
WHISPER_MODEL_CACHE_DIR=pretrained_models/faster_whisper
SAMPLE_RATE=16000
CHANNELS=1
VAD_ENERGY_THRESHOLD=0.0015
VAD_THRESHOLD=0.4
VAD_MIN_SILENCE_MS=200
VAD_SPEECH_PAD_MS=120

# ── Speaker diarization (Nemotron-3-Diarization) ──────────────────────────
# GPU when available, otherwise CPU
DIAR_DEVICE=auto
# auto | fp32 | fp16 | bf16  (auto: bf16/fp16 on CUDA, fp32 on CPU)
DIAR_PRECISION=auto
# transformers (default) | nemo | auto (tries NeMo then Transformers)
DIAR_BACKEND=transformers
# low_latency | very_low_latency | ultra_low_latency | offline
DIAR_STREAMING_MODE=ultra_low_latency
# NEMOTRON_MODEL_ID=nvidia/Nemotron-3-Diarization
# DIAR_CACHE_DIR=pretrained_models/nemotron_diar

# true = skip Nemotron and label everything Speaker 1
SINGLE_SPEAKER_MODE=false
# SOLE_SPEAKER_ID=speaker_001
# SOLE_SPEAKER_DISPLAY=Speaker 1

# When diarization has no label for a short clip, inherit last speaker
ALLOW_LAST_SPEAKER_FALLBACK=true

MIN_NEW_SPEAKER_SEG_S=1.2
SEGMENT_PAD_S=0.15

WINDOW_S=1.5
STEP_S=1.0

RESOLVE_TIMELINE_OVERLAP=true
MIN_EMIT_DURATION_S=0.05
